# ============================================================
# Uncover Bricks Ottawa — environment configuration
# Copy this file to .env.local and fill in real values.
# Everything below is a PLACEHOLDER until you have credentials.
# ============================================================

# --- CREA DDF (Data Distribution Facility) ---
# Apply for access at https://www.crea.ca/ddf/ — CREA issues these
# after your data feed agreement is approved.
# Docs: https://ddfapi-docs.realtor.ca/
DDF_CLIENT_ID=YOUR_DDF_CLIENT_ID_HERE
DDF_CLIENT_SECRET=YOUR_DDF_CLIENT_SECRET_HERE

# Set to "true" ONLY after the credentials above are real.
# While "false", the site serves realistic mock listings.
DDF_USE_LIVE=false

# --- Lead notifications (Pre-Construction form) ---
# Leads are always saved to data/leads.json. To ALSO get an email
# per lead, sign up at https://resend.com, create an API key, and
# fill these in. Until then, email sending is skipped (placeholder).
RESEND_API_KEY=YOUR_RESEND_API_KEY_HERE
LEAD_NOTIFY_EMAIL=you@youragency.ca
LEAD_FROM_EMAIL=leads@yourdomain.ca
